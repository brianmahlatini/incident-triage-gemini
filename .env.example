# ---------------------------------------------------------------------------
# Provider selection.
#   mock   - deterministic offline provider (default; no credentials needed)
#   gemini - live Gemini call via the google-genai SDK
# ---------------------------------------------------------------------------
TRIAGE_PROVIDER=mock

# --- Option A: Gemini Developer API (fastest to try) ---
# Note: the free tier is capped at 20 requests per day per model, which is not
# enough to complete a full 30-case evaluation run. Use eval --limit, or a
# billed project, for a complete run.
GOOGLE_API_KEY=

# --- Option B: Vertex AI (what production would actually use) ---
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=europe-west1

TRIAGE_MODEL=gemini-3.5-flash
TRIAGE_TEMPERATURE=0.1
TRIAGE_MAX_RETRIES=3
TRIAGE_TIMEOUT_SECONDS=30

# Output budget. Must cover *thinking* tokens as well as the answer: Gemini 3.x
# models reason before responding and those tokens count against this limit.
# At 1024 a triage record came back truncated after spending 980 on reasoning.
TRIAGE_MAX_OUTPUT_TOKENS=2048

# Thinking budget, where the model allows one. Leave unset for the model
# default. 0 disables reasoning and roughly quarters latency on this task, but
# not every model accepts it (gemini-3.6-flash returns 400) - the provider
# detects the rejection and retries without it.
# TRIAGE_THINKING_BUDGET=0

# Confidence below this threshold routes the incident to a human reviewer.
TRIAGE_CONFIDENCE_THRESHOLD=0.70

# Log level: DEBUG | INFO | WARNING | ERROR
TRIAGE_LOG_LEVEL=INFO
